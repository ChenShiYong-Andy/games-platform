# 镜像（与推送时 IMAGE_REGISTRY / IMAGE_TAG 保持一致）
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/aliyun_andy/games-platform-backend:1.0.0
FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/aliyun_andy/games-platform-frontend:1.0.0

# 服务端口
FRONTEND_PORT=80
BACKEND_PORT=8080

# 连接 docker/database 中的容器（一般无需修改）
MYSQL_HOST=games-platform-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=games_platform
MYSQL_USER=games
MYSQL_PASSWORD=games123
REDIS_HOST=games-platform-redis
REDIS_PORT=6379
REDIS_PASSWORD=
