# 镜像（与推送时 IMAGE_REGISTRY / IMAGE_TAG 保持一致）
ADMIN_IMAGE=registry.cn-hangzhou.aliyuncs.com/aliyun_andy/games-platform-admin:2.0.0
ADMIN_UI_IMAGE=registry.cn-hangzhou.aliyuncs.com/aliyun_andy/games-platform-admin-ui:2.0.0

# 服务端口
ADMIN_UI_PORT=80
ADMIN_PORT=8080

# 连接 docker/database 中的容器（一般无需修改）
MYSQL_HOST=games-platform-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=games_platform
MYSQL_USER=games
MYSQL_PASSWORD=games123
REDIS_HOST=games-platform-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=games-platform

# 普通用户与独立管理员认证；生产部署时建议重新生成
JWT_SECRET=1f702134957b3c014fce729cc5a8d0dc5a29ea26f2f3316b593961c64c2252bc
ADMIN_JWT_SECRET=d0b6e66b3068b64348eb5472a7b9c0f833ad812ac4a6d5d8a4e17ec139a5548c
ADMIN_JWT_EXPIRATION=28800000
ADMIN_BINDING_CODE_TTL_MINUTES=10

# OpenAI 兼容协议通用配置
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# 文本大模型（留空时继承 OPENAI_*）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
