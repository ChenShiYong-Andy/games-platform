# ========== 应用镜像（本地构建后推送到此仓库，部署时从此拉取） ==========
# 阿里云 ACR 示例（仅填「地址/命名空间」，不要带仓库名）:
#   IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com/aliyun_andy
# 推送后镜像为:
#   registry.cn-hangzhou.aliyuncs.com/aliyun_andy/games-platform-backend:1.0.0
IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace
IMAGE_TAG=1.0.0
BACKEND_IMAGE_NAME=games-platform-backend
FRONTEND_IMAGE_NAME=games-platform-frontend

# 阿里云 ACR 登录凭证（推送前自动 docker login）
# 用户名通常为命名空间名；密码为控制台「访问凭证」中的固定密码
REGISTRY_USERNAME=your-namespace
REGISTRY_PASSWORD=your-acr-password

# 构建目标平台（Mac M 系列本地构建、x86 服务器部署时必须为 linux/amd64）
PLATFORM=linux/amd64

# ========== 基础镜像 ==========
# 后端 Java 运行时（Microsoft OpenJDK 21）
OPENJDK_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
# 前端 build 及 MySQL/Redis 拉取（国内默认 DaoCloud 加速）
BUILD_REGISTRY=docker.m.daocloud.io/library

# ========== 服务端口 ==========
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# ========== MySQL 配置 ==========
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=games_platform
MYSQL_USER=games
MYSQL_PASSWORD=games123

# ========== Redis 配置（默认无密码） ==========
REDIS_PASSWORD=
